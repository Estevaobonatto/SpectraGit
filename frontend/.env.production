# SpectraGit Frontend — Production
# For production builds served alongside the API (same origin), use relative path.
# If serving from a separate CDN/server, set to the full API URL:
#   VITE_API_URL=https://api.yourdomain.com/api/v1

VITE_API_URL=/api/v1
VITE_APP_NAME=SpectraGit
VITE_DEPLOYMENT_MODE=saas
