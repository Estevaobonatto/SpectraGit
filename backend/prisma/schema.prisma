generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Self-Hosted Instance Settings ──────────────────────────

model InstanceSettings {
  id                     String   @id @default("singleton") @db.VarChar(10)
  appName                String   @default("SpectraGit") @map("app_name") @db.VarChar(100)
  appLogoUrl             String?  @map("app_logo_url") @db.VarChar(512)
  primaryColor           String   @default("#7C3AED") @map("primary_color") @db.VarChar(7)
  baseUrl                String   @default("http://localhost") @map("base_url") @db.VarChar(512)
  smtpHost               String?  @map("smtp_host") @db.VarChar(255)
  smtpPort               Int?     @map("smtp_port")
  smtpUser               String?  @map("smtp_user") @db.VarChar(255)
  smtpFromEmail          String?  @map("smtp_from_email") @db.VarChar(255)
  encryptedSmtpPassword  String?  @map("encrypted_smtp_password") @db.Text
  isSetupComplete        Boolean  @default(false) @map("is_setup_complete")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

// ─── Users & Auth ────────────────────────────────────────────

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(39)
  email        String     @unique @db.VarChar(255)
  displayName  String?    @map("display_name") @db.VarChar(100)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(512)
  bio          String?    @db.VarChar(500)
  location     String?    @db.VarChar(255)
  website      String?    @db.VarChar(512)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  systemRole   SystemRole @default(USER) @map("system_role")
  isDisabled   Boolean    @default(false) @map("is_disabled")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  oauthAccounts  OAuthAccount[]
  sessions       Session[]
  sshKeys        SSHKey[]
  ownedRepos     Repository[]       @relation("RepoOwner")
  repoMembers    RepositoryMember[]
  authoredIssues Issue[]            @relation("IssueAuthor")
  assignedIssues Issue[]            @relation("IssueAssignee")
  authoredPRs         PullRequest[]         @relation("PRAuthor")
  mergedPRs           PullRequest[]         @relation("PRMerger")
  reviews             Review[]
  comments            Comment[]             @relation("CommentAuthor")
  resolvedComments    Comment[]             @relation("CommentResolver")
  reviewerRequests    PullRequestReviewer[] @relation("RequestedReviewer")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  orgMembers     OrganizationMember[]
  teamMembers    TeamMember[]
  auditLogs      AuditLog[]
  importJobs     ImportJob[]
  pulses         RepositoryPulse[]
  watches        RepositoryWatch[]
  personalAccessTokens PersonalAccessToken[]
  activityEvents       ActivityEvent[]
  authoredReleases     Release[]      @relation("ReleaseAuthor")
  profile              UserProfile?

  @@map("users")
}

model OAuthAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  provider              String   @db.VarChar(20)
  providerUserId        String   @map("provider_user_id") @db.VarChar(255)
  encryptedAccessToken  String?  @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?  @map("encrypted_refresh_token") @db.Text
  scope                 String?  @db.VarChar(1000)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

// ─── User Profile Customization ──────────────────────────────

model UserProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  readmeContent     String?  @map("readme_content") @db.Text
  aboutMe           String?  @map("about_me") @db.Text
  backgroundType    String   @default("solid") @map("background_type") @db.VarChar(20)
  backgroundColor   String?  @map("background_color") @db.VarChar(20)
  backgroundImage   String?  @map("background_image") @db.VarChar(512)
  customCss         String?  @map("custom_css") @db.Text
  commitChartColor  String?  @map("commit_chart_color") @db.VarChar(20)
  commitChartStyle  String?  @map("commit_chart_style") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections        UserProfileSection[]
  socialLinks     UserSocialLink[]
  pinnedRepos     UserPinnedRepository[]
  skills          UserSkill[]
  projects        UserProfileProject[]

  @@map("user_profiles")
}

model UserProfileSection {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  title         String   @db.VarChar(100)
  content       String   @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("user_profile_sections")
}

model UserSocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  platform  String   @db.VarChar(50)
  label     String   @db.VarChar(100)
  url       String   @db.VarChar(512)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_social_links")
}

model UserPinnedRepository {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, repositoryId])
  @@index([profileId, sortOrder])
  @@map("user_pinned_repositories")
}

model UserSkill {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid
  name            String   @db.VarChar(100)
  proficiency     Int      @default(50)
  relatedProjects String[] @map("related_projects")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_skills")
}

model UserProfileProject {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  repoUrl     String?  @map("repo_url") @db.VarChar(512)
  liveUrl     String?  @map("live_url") @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_profile_projects")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @map("refresh_token") @db.Text
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model SSHKey {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(100)
  fingerprint String   @unique @db.VarChar(255)
  publicKey   String   @map("public_key") @db.Text
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ssh_keys")
}

// ─── Organizations & Teams ───────────────────────────────────

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(39)
  displayName String?  @map("display_name") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members      OrganizationMember[]
  teams        Team[]
  repositories Repository[] @relation("OrgRepos")

  @@map("organizations")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  repoAccess   TeamRepoAccess[]

  @@unique([orgId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ─── Repositories ────────────────────────────────────────────

enum RepoVisibility {
  PUBLIC
  PRIVATE
}

enum RepoRole {
  ADMIN
  MAINTAINER
  WRITE
  READ
}

model Repository {
  id                String         @id @default(uuid()) @db.Uuid
  ownerUserId       String?        @map("owner_user_id") @db.Uuid
  ownerOrgId        String?        @map("owner_org_id") @db.Uuid
  name              String         @db.VarChar(100)
  slug              String         @db.VarChar(100)
  description       String?        @db.VarChar(500)
  website           String?        @db.VarChar(512)
  topics            String[]       @default([])
  visibility        RepoVisibility @default(PUBLIC)
  defaultBranch     String         @default("main") @map("default_branch") @db.VarChar(255)
  hasIssuesEnabled  Boolean        @default(true) @map("has_issues_enabled")
  hasPRsEnabled     Boolean        @default(true) @map("has_prs_enabled")
  hasWikiEnabled    Boolean        @default(false) @map("has_wiki_enabled")
  allowMergeCommit  Boolean        @default(true) @map("allow_merge_commit")
  allowSquashMerge  Boolean        @default(true) @map("allow_squash_merge")
  allowRebaseMerge  Boolean        @default(false) @map("allow_rebase_merge")
  autoDeleteBranch  Boolean        @default(false) @map("auto_delete_branch")
  prRiskConfig      Json?          @map("pr_risk_config")
  isArchived        Boolean        @default(false) @map("is_archived")
  isFork            Boolean        @default(false) @map("is_fork")
  forkSourceRepoId  String?        @map("fork_source_repo_id") @db.Uuid
  githubExternalId  String?        @map("github_external_id") @db.VarChar(255)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  ownerUser      User?              @relation("RepoOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerOrg       Organization?      @relation("OrgRepos", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  forkSource     Repository?        @relation("Forks", fields: [forkSourceRepoId], references: [id], onDelete: SetNull)
  forks          Repository[]       @relation("Forks")
  members        RepositoryMember[]
  branches       Branch[]
  tags           Tag[]
  issues         Issue[]
  pullRequests   PullRequest[]
  labels         Label[]
  milestones     Milestone[]
  teamAccess     TeamRepoAccess[]
  pulses         RepositoryPulse[]
  watches        RepositoryWatch[]
  activityEvents ActivityEvent[]
  releases       Release[]
  webhooks       Webhook[]
  pinnedBy       UserPinnedRepository[]

  @@unique([ownerUserId, slug])
  @@unique([ownerOrgId, slug])
  @@index([ownerUserId])
  @@index([ownerOrgId])
  @@map("repositories")
}

model RepositoryMember {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         RepoRole @default(READ)
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@map("repository_members")
}

model TeamRepoAccess {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  role         RepoRole @default(READ)
  createdAt    DateTime @default(now()) @map("created_at")

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([teamId, repositoryId])
  @@map("team_repo_access")
}

// ─── Branches & Tags ─────────────────────────────────────────

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  repositoryId  String   @map("repository_id") @db.Uuid
  name          String   @db.VarChar(255)
  headCommitSha String?  @map("head_commit_sha") @db.VarChar(40)
  isProtected   Boolean  @default(false) @map("is_protected")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  repository      Repository           @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  protectionRule  BranchProtectionRule?

  @@unique([repositoryId, name])
  @@map("branches")
}

model BranchProtectionRule {
  id                      String  @id @default(uuid()) @db.Uuid
  branchId                String  @unique @map("branch_id") @db.Uuid
  requirePullRequest      Boolean @default(true) @map("require_pull_request")
  requiredReviewCount     Int     @default(1) @map("required_review_count")
  dismissStaleReviews     Boolean @default(false) @map("dismiss_stale_reviews")
  requireCodeOwnerReview  Boolean @default(false) @map("require_code_owner_review")
  restrictPushes          Boolean @default(true) @map("restrict_pushes")
  allowForcePushes        Boolean @default(false) @map("allow_force_pushes")
  allowDeletions          Boolean @default(false) @map("allow_deletions")
  requireLinearHistory    Boolean @default(false) @map("require_linear_history")
  lockBranch              Boolean @default(false) @map("lock_branch")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_protection_rules")
}

// ─── Webhooks ────────────────────────────────────────────────

model Webhook {
  id           String    @id @default(uuid()) @db.Uuid
  repositoryId String    @map("repository_id") @db.Uuid
  url          String    @db.VarChar(2048)
  secret       String?   @db.VarChar(255)
  contentType  String    @default("application/json") @map("content_type") @db.VarChar(50)
  events       String[]  @default(["push"])
  isActive     Boolean   @default(true) @map("is_active")
  lastStatus   Int?      @map("last_status")
  lastError    String?   @map("last_error") @db.Text
  lastCalledAt DateTime? @map("last_called_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("webhooks")
}

model Tag {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  name         String   @db.VarChar(255)
  commitSha    String   @map("commit_sha") @db.VarChar(40)
  message      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  release    Release?

  @@unique([repositoryId, name])
  @@map("tags")
}

// ─── Releases ────────────────────────────────────────────────

model Release {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  tagId        String   @unique @map("tag_id") @db.Uuid
  name         String   @db.VarChar(255)
  body         String?  @db.Text
  targetBranch String   @default("main") @map("target_branch") @db.VarChar(255)
  isDraft      Boolean  @default(false) @map("is_draft")
  isPrerelease Boolean  @default(false) @map("is_prerelease")
  authorId     String   @map("author_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tag        Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  author     User            @relation("ReleaseAuthor", fields: [authorId], references: [id])
  assets     ReleaseAsset[]

  @@index([repositoryId])
  @@map("releases")
}

model ReleaseAsset {
  id          String   @id @default(uuid()) @db.Uuid
  releaseId   String   @map("release_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(255)
  filePath    String   @map("file_path") @db.VarChar(1000)
  contentType String   @map("content_type") @db.VarChar(255)
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@map("release_assets")
}

// ─── Issues ──────────────────────────────────────────────────

enum IssueStatus {
  OPEN
  CLOSED
  TRIAGE
  CONFIRMED
  IN_PROGRESS
  BLOCKED
  WAITING_USER
  RESOLVED
  WONT_FIX
}

enum IssueType {
  BUG
  FEATURE
  QUESTION
  SUPPORT
  IMPROVEMENT
}

enum IssuePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueCloseReason {
  FIXED
  DUPLICATE
  NOT_REPRODUCIBLE
  NOT_PLANNED
  OBSOLETE
}

model Issue {
  id               String            @id @default(uuid()) @db.Uuid
  repositoryId     String            @map("repository_id") @db.Uuid
  authorId         String            @map("author_id") @db.Uuid
  assigneeId       String?           @map("assignee_id") @db.Uuid
  number           Int
  title            String            @db.VarChar(255)
  body             String?           @db.Text
  status           IssueStatus       @default(OPEN)
  type             IssueType?        @map("type")
  priority         IssuePriority?    @map("priority")
  closeReason      IssueCloseReason? @map("close_reason")
  closeReasonNote  String?           @map("close_reason_note") @db.Text
  assignedArea     String?           @map("assigned_area") @db.VarChar(100)
  techContext      Json?             @map("tech_context")
  formData         Json?             @map("form_data")
  milestoneId      String?           @map("milestone_id") @db.Uuid
  githubExternalId String?           @map("github_external_id") @db.VarChar(255)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  repository Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author     User         @relation("IssueAuthor", fields: [authorId], references: [id])
  assignee   User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone  Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments   Comment[]
  labels     IssueLabel[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorId])
  @@index([repositoryId, githubExternalId])
  @@index([repositoryId, status])
  @@index([repositoryId, type])
  @@map("issues")
}

model Label {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  name         String   @db.VarChar(50)
  color        String   @db.VarChar(7)
  description  String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issues     IssueLabel[]
  pullRequests PRLabel[]

  @@unique([repositoryId, name])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@map("issue_labels")
}

model Milestone {
  id           String    @id @default(uuid()) @db.Uuid
  repositoryId String    @map("repository_id") @db.Uuid
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  dueDate      DateTime? @map("due_date")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issues     Issue[]

  @@unique([repositoryId, title])
  @@map("milestones")
}

// ─── Pull Requests ───────────────────────────────────────────

enum PRStatus {
  OPEN
  CLOSED
  MERGED
}

enum MergeStrategy {
  MERGE_COMMIT
  SQUASH
}

model PullRequest {
  id               String         @id @default(uuid()) @db.Uuid
  repositoryId     String         @map("repository_id") @db.Uuid
  authorId         String         @map("author_id") @db.Uuid
  number           Int
  sourceBranch     String         @map("source_branch") @db.VarChar(255)
  targetBranch     String         @map("target_branch") @db.VarChar(255)
  title            String         @db.VarChar(255)
  body             String?        @db.Text
  status           PRStatus       @default(OPEN)
  mergeStrategy    MergeStrategy? @map("merge_strategy")
  mergedBy         String?        @map("merged_by") @db.Uuid
  mergedAt         DateTime?      @map("merged_at")
  isDraft          Boolean        @default(false) @map("is_draft")
  checklist        Json           @default("[]") @map("checklist")
  contextBlocks    Json?          @map("context_blocks")
  githubExternalId String?        @map("github_external_id") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  repository         Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author             User                   @relation("PRAuthor", fields: [authorId], references: [id])
  merger             User?                  @relation("PRMerger", fields: [mergedBy], references: [id], onDelete: SetNull)
  reviews            Review[]
  comments           Comment[]
  labels             PRLabel[]
  requestedReviewers PullRequestReviewer[]
  dependenciesOut    PullRequestDependency[] @relation("DependentPR")
  dependenciesIn     PullRequestDependency[] @relation("DependsOnPR")

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorId])
  @@index([repositoryId, githubExternalId])
  @@map("pull_requests")
}

model PRLabel {
  pullRequestId String @map("pull_request_id") @db.Uuid
  labelId       String @map("label_id") @db.Uuid

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  label       Label       @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([pullRequestId, labelId])
  @@map("pr_labels")
}

model PullRequestReviewer {
  id            String   @id @default(uuid()) @db.Uuid
  pullRequestId String   @map("pull_request_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  requestedAt   DateTime @default(now()) @map("requested_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user        User        @relation("RequestedReviewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@map("pull_request_reviewers")
}

model PullRequestDependency {
  id             String @id @default(uuid()) @db.Uuid
  dependentPrId  String @map("dependent_pr_id") @db.Uuid
  dependsOnPrId  String @map("depends_on_pr_id") @db.Uuid
  repositoryId   String @map("repository_id") @db.Uuid

  dependentPR PullRequest @relation("DependentPR", fields: [dependentPrId], references: [id], onDelete: Cascade)
  dependsOnPR PullRequest @relation("DependsOnPR", fields: [dependsOnPrId], references: [id], onDelete: Cascade)

  @@unique([dependentPrId, dependsOnPrId])
  @@map("pull_request_dependencies")
}

// ─── Reviews & Comments ──────────────────────────────────────

enum ReviewStatus {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  pullRequestId String       @map("pull_request_id") @db.Uuid
  reviewerId    String       @map("reviewer_id") @db.Uuid
  status        ReviewStatus
  body          String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])
  comments    Comment[]

  @@index([pullRequestId])
  @@map("reviews")
}

enum CommentType {
  ISSUE
  PULL_REQUEST
  REVIEW_INLINE
}

model Comment {
  id            String      @id @default(uuid()) @db.Uuid
  authorId      String      @map("author_id") @db.Uuid
  type          CommentType
  issueId       String?     @map("issue_id") @db.Uuid
  pullRequestId String?     @map("pull_request_id") @db.Uuid
  reviewId      String?     @map("review_id") @db.Uuid
  body          String      @db.Text
  filePath      String?     @map("file_path") @db.VarChar(1000)
  lineNumber    Int?        @map("line_number")
  resolved      Boolean     @default(false)
  resolvedById  String?     @map("resolved_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  author      User         @relation("CommentAuthor", fields: [authorId], references: [id])
  resolvedBy  User?        @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  issue       Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  review      Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([pullRequestId])
  @@index([reviewId])
  @@map("comments")
}

// ─── Notifications ───────────────────────────────────────────

enum NotificationType {
  ISSUE_CREATED
  ISSUE_COMMENT
  PR_CREATED
  PR_COMMENT
  PR_REVIEW
  PR_MERGED
  MENTION
  REPO_INVITE
  ORG_INVITE
  COLLABORATOR_ADDED
  COLLABORATOR_REMOVED
  COLLABORATOR_ROLE_CHANGED
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  payloadJson Json?            @map("payload_json")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

// ─── Repository Engagement (Pulse & Watch) ──────────────────

model RepositoryPulse {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@index([userId])
  @@map("repository_pulses")
}

model RepositoryWatch {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@index([userId])
  @@map("repository_watches")
}

// ─── Audit Log ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(255)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Import Jobs ─────────────────────────────────────────────

enum ImportJobStatus {
  PENDING
  CLONING
  SEEDING_BRANCHES
  IMPORTING_LABELS
  IMPORTING_MILESTONES
  IMPORTING_ISSUES
  IMPORTING_PRS
  IMPORTING_TAGS
  COMPLETED
  FAILED
}

model ImportJob {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  repositoryId        String?         @map("repository_id") @db.Uuid
  githubRepoFullName  String          @map("github_repo_full_name") @db.VarChar(255)
  status              ImportJobStatus @default(PENDING)
  progress            Int             @default(0)
  currentStep         String?         @map("current_step") @db.VarChar(255)
  error               String?         @db.Text
  repositorySlug      String?         @map("repository_slug") @db.VarChar(100)
  ownerUsername        String?         @map("owner_username") @db.VarChar(39)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("import_jobs")
}

// ─── Personal Access Tokens ──────────────────────────────────

model PersonalAccessToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(100)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  tokenPrefix  String    @map("token_prefix") @db.VarChar(12)
  scopes       String[]  @default(["repo"])
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("personal_access_tokens")
}

// ─── Activity Events ─────────────────────────────────────────

enum ActivityType {
  PUSH
  BRANCH_CREATED
  BRANCH_DELETED
  TAG_CREATED
  REPO_CREATED
  REPO_FORKED
  ISSUE_OPENED
  ISSUE_CLOSED
  PR_OPENED
  PR_MERGED
  PR_CLOSED
  COMMENT_ADDED
  REVIEW_SUBMITTED
  MEMBER_ADDED
}

model ActivityEvent {
  id           String       @id @default(uuid()) @db.Uuid
  repositoryId String?      @map("repository_id") @db.Uuid
  actorId      String       @map("actor_id") @db.Uuid
  type         ActivityType
  ref          String?      @db.VarChar(255)
  beforeSha    String?      @map("before_sha") @db.VarChar(40)
  afterSha     String?      @map("after_sha") @db.VarChar(40)
  metadata     Json?        @map("metadata")
  createdAt    DateTime     @default(now()) @map("created_at")

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_events")
}
