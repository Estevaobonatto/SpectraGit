# SpectraGit — environment variables
# Copy this file to .env and fill in all values before starting with Docker Compose.
#
#   cp .env.example .env
#
# Lines starting with # are comments. DO NOT commit your .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED: set a strong password for PostgreSQL.
POSTGRES_USER=spectragit
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=spectragit
DATABASE_URL=postgresql://spectragit:${POSTGRES_PASSWORD}@postgres:5432/spectragit?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Set REDIS_PASSWORD if you enable Redis AUTH (requirepass in redis.conf)
# REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: generate strong random secrets (min 32 characters), e.g.:
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth providers (optional) ────────────────────────────────────────────────
# Leave as "placeholder" to disable. Configure only the providers you need.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
# Must match the callback URL registered in the Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
# Must match the callback URL registered in the GitHub OAuth App settings
GITHUB_CALLBACK_URL=http://localhost/api/v1/auth/oauth/github/callback

# ── URLs ──────────────────────────────────────────────────────────────────────
# The public-facing base URL of the instance (without trailing slash).
# Used in CORS, cookies, email links, and clone URLs.
# Change to your domain when deploying, e.g. https://git.company.com
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# ── Git storage ───────────────────────────────────────────────────────────────
# Absolute path inside the container where bare git repos are stored.
# Mapped to the git_storage Docker volume — do not change unless you know what you're doing.
GIT_STORAGE_PATH=/data/repositories

# ── S3 / Object Storage (release assets) ────────────────────────────────────
# Hetzner Object Storage (S3-compatible). Change endpoint/region to match your bucket location.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# ── Deployment mode ───────────────────────────────────────────────────────────
# self-hosted = enables admin panel, setup wizard, and instance-level settings.
# saas        = disables admin features; managed via code / infra.
DEPLOYMENT_MODE=self-hosted

# ── SSH server (git push/pull over SSH) ──────────────────────────────────────
SSH_PORT=2222
